# --- Mistral (agent) ---
MISTRAL_API_KEY=
# Any model with function calling. mistral-large-latest is the safest default.
MISTRAL_MODEL=mistral-large-latest

# --- Elasticsearch ---
# Local docker (see docker-compose.yml): http://localhost:9200 with security disabled.
ELASTICSEARCH_URL=http://localhost:9200
# For Elastic Cloud / Serverless, set either an API key or basic auth.
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=sf311-cases
# Closed-loop challenge data (agent-created challenges + player observations) is kept separate from the 311 mirror.
ELASTICSEARCH_CHALLENGES_INDEX=sf-challenges
ELASTICSEARCH_OBSERVATIONS_INDEX=sf-observations

# --- Dev agent (sidebar "chat with the data") ---
# Separate Elastic project with exemplary data, used while interfaces are being built.
# Enabled automatically in `next dev`; set DEV_AGENT=1 to force on (e.g. in a preview build) or 0 to hide it.
ELASTIC_DEV_ENDPOINT=
ELASTIC_DEV_API_KEY=
DEV_AGENT=

# --- OpenStreetMap (Overpass) ---
# Comma-separated endpoints tried in order. Public mirrors are rate-limited; the agent degrades gracefully if all fail.
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter

# --- SF Open Data (seeding only) ---
# Optional Socrata app token for higher rate limits: https://data.sfgov.org/profile/edit/developer_settings
SF_OPEN_DATA_APP_TOKEN=

# --- Dev toggles ---
# Set to 1 to serve a fixture quest from /api/quest without hitting Mistral or Elasticsearch.
QUEST_MOCK=0
